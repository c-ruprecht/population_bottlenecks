import os
from snakemake.io import expand, directory
import re
import glob

# PATHS
OUTPUT_DIR = '/sc/arion/work/ruprec02/population-bottlenecks/'
SCRIPTS_DIR = '/hpc/users/ruprec02/git/population_bottlenecks/scripts'
METADIR = '/hpc/users/ruprec02/git/population_bottlenecks/input_files'

# Create main output directory structure
os.makedirs(OUTPUT_DIR, exist_ok=True)


def get_all_moleculetables(wildcards):
    """Dynamically discover moleculetable files created by checkpoint"""
    checkpoint_output = checkpoints.create_experiments.get(**wildcards).output[0]
    all_files = glob.glob(os.path.join(checkpoint_output, '**/moleculetables/*_moleculestable.csv'), recursive=True)

    # Extract experiment and strain from each file
    samples = []
    for f in all_files:
        # Parse the path to get experiment and strain
        # Expected: .../P4C1T8/moleculetables/c1_ST1_moleculestable.csv
        parts = f.split('/')
        experiment = parts[-3]  # P4C1T8 or P4C2T4T5
        filename = parts[-1]    # c1_ST1_moleculestable.csv

        # Extract strain from filename
        if experiment == 'P4C1T8':
            # Format: c1_ST1_moleculestable.csv -> c1_ST1
            strain = filename.replace('_moleculestable.csv', '')
        else:  # P4C2T4T5
            # Format: ST1_moleculestable.csv -> ST1
            strain = filename.replace('_moleculestable.csv', '')

        samples.append((experiment, strain))

    return samples


rule all:
    input:
        lambda wildcards: expand(OUTPUT_DIR + "FP/{experiment}/{strain}/TableOfEstimates.csv",
                                 zip,
                                 experiment=[s[0] for s in get_all_moleculetables(wildcards)],
                                 strain=[s[1] for s in get_all_moleculetables(wildcards)])


checkpoint create_experiments:
    output:
        directory(OUTPUT_DIR + "moleculetables")
    params:
        basepath = OUTPUT_DIR,
        metadir = METADIR,
        scripts_dir = SCRIPTS_DIR
    shell:
        """
        conda run -n umi_tools_env python {params.scripts_dir}/create_experiment_moleculetables.py \
            -b {params.basepath} \
            -m {params.metadir} \
            -o {output}
        """


rule cluster_moleculetables:
    input:
        readstable = OUTPUT_DIR + "moleculetables/{experiment}/moleculetables/{strain}_moleculestable.csv"
    output:
        OUTPUT_DIR + "clustered/{experiment}/{strain}_clustered.csv"
    params:
        scripts_dir = SCRIPTS_DIR,
        output_prefix = OUTPUT_DIR + "clustered/{experiment}/{strain}"
    log:
        OUTPUT_DIR + "logs/{experiment}/{strain}_clustering.log"
    shell:
        """
        mkdir -p $(dirname {output})
        mkdir -p $(dirname {log})
        conda run -n umi_tools_env python {params.scripts_dir}/cluster_moleculetables.py \
            --input {input.readstable} \
            --output {params.output_prefix} &> {log}
        """
    
rule get_resilient_FP:
    input:
        readstable = OUTPUT_DIR + "clustered/{experiment}/{strain}_clustered.csv"
    output:
        OUTPUT_DIR + "FP/{experiment}/{strain}/TableOfEstimates.csv"
    params:
        output_dir = OUTPUT_DIR + "FP/{experiment}/{strain}/",
        scripts_dir = SCRIPTS_DIR,
        inoc_cfu = 1000000,  # Adjust this value based on your experimental inoculum CFU
        minweight = 0.03,     # Minimum weight threshold (3%)
        correct_noise = 0.001     # Noise correction factor (0 = no correction)
    conda:
        "../environments/r_bottleneck.yaml"
    log:
        OUTPUT_DIR + "logs/{experiment}/{strain}_FP.log"
    shell:
        """
        mkdir -p {params.output_dir}
        mkdir -p $(dirname {log})

        # Dynamically find gavage column indices (1-indexed for R)
        WHERE_REFS=$(python -c "
import pandas as pd
import sys
df = pd.read_csv('{input.readstable}')
gavage_cols = [i+1 for i, col in enumerate(df.columns) if 'gavage' in str(col).lower()]
print(','.join(map(str, gavage_cols)) if gavage_cols else '1')
")

        echo "Using gavage columns: $WHERE_REFS" >> {log}

        conda run -n r_bottleneck Rscript {params.scripts_dir}/FinalResiliencyWithCFU_wrapper.R \
            {input.readstable} \
            NULL \
            {params.inoc_cfu} \
            "$WHERE_REFS" \
            {params.minweight} \
            {params.correct_noise} \
            {params.output_dir} \
            NULL &>> {log}
        """


